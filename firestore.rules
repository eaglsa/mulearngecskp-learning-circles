rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /circles/{circleId} {
      // All reads are open — public pages filter client-side to "approved".
      // Admin panel reads everything; its gate is the UI password, not Firestore identity.
      allow read: if true;

      // Anyone can submit a new circle request, always starting as "pending".
      allow create: if request.resource.data.status == "pending"
                    && request.resource.data.keys().hasAll(
                         ["name","topic","description","hostName",
                          "hostContact","hostDepartment","passwordHash","createdAt"]);

      // Updates: admin field edits + status changes + updatedAt stamp are all permitted.
      allow update: if true;

      // Admin cascade-delete (confirmCircleDeletion deletes the doc after participants).
      allow delete: if true;

      match /participants/{participantId} {
        // Anyone can read participants (circle-level read is already gated above).
        allow read: if true;

        // Adding a participant needs the correct shape.
        allow create: if request.resource.data.keys().hasAll(
                         ["name","department","avatarSeed","addedAt"]);

        // Host can rename a participant (name field only).
        allow update: if request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(["name"]);

        // Host can remove a participant.
        allow delete: if true;
      }
    }
  }
}
