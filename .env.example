# μLearn Learning Circles — Environment Variables
# Copy this file to .env and fill in your Firebase project values.
# All VITE_ prefixed vars are exposed to the browser (this is intentional and safe).

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Admin panel password hash (bcrypt, 10 rounds)
# Default below is the hash for "mulearn-admin" — CHANGE THIS before deploying.
# Generate a new hash: node -e "const b=require('bcryptjs'); b.hash('yourpassword',10).then(console.log)"
VITE_ADMIN_PASSWORD_HASH=$2a$10$Xm.L9eEFxCZSu1pY8bsq6eP/nkKnJRZWFJWQfHTPumxl5uy0F9FGS
